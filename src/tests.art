// Flujos principales. Ninguno envía el pedido: con ORDERS_EMAIL puesto, mandaría un email de verdad.

test "suma variedades y calcula el total" {
  click "Agregar Chorizo colorado"
  click "Agregar Clásica"
  click "Sumar una bolsa de Clásica"
  see "Envíos solo en la Comunitat Valenciana"
  see "3 bolsas"
  see "Enviar pedido · 26 €"
}

test "pide los datos antes de enviar" {
  click "Agregar Queso azul y nuez"
  click "Enviar pedido · 10 €"
  see "Decinos tu nombre."
  fill "Ej. Ana García" "Ana"
  fill "Ej. 600 123 456" "600 12"
  click "Enviar pedido · 10 €"
  see "Revisá el teléfono"
}

test "el ticket ajusta cantidades y total" {
  click "Agregar Longaniza de Pascua"
  click "Sumar una bolsa de Longaniza de Pascua"
  see "Enviar pedido · 20 €"
  click "Quitar una bolsa de Longaniza de Pascua" 1
  see "Enviar pedido · 10 €"
  see "Sin pago online"
}

test "preguntas frecuentes y pie" {
  see "¿Hacen envíos fuera de la Comunitat Valenciana?"
  see "Hecho con"
  see "ArtScript"
}

test "rechaza datos fuera de medida" {
  click "Agregar Clásica"
  fill "Ej. Ana García" "Ana García Ana García Ana García Ana García Ana García Ana García Ana García Ana García"
  click "Enviar pedido · 8 €"
  see "El nombre es muy largo"
  fill "Ej. Ana García" "Ana García"
  fill "Ej. 600 123 456" "6001234567890123"
  click "Enviar pedido · 8 €"
  see "entre 9 y 15 cifras"
}

test "la dirección tiene que salir del buscador" {
  click "Agregar Chorizo colorado"
  fill "Ej. Ana García" "Ana García"
  fill "Ej. 600 123 456" "600 123 456"
  click "Enviar pedido · 10 €"
  see "Elegí tu dirección de la lista"
}
