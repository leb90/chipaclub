// El formulario de pedido: cantidades, datos del cliente, envío y confirmación.
component OrderSection() {
  state name = ""
  state phone = ""
  state address = ""
  state spot: Any = null
  state geoOffline = false
  state notes = ""
  state sending = false
  state error = ""
  state errorField = ""
  state copied = false
  state openedAt = Date.now()
  ref box
  ref placedBox

  mount {
    let io = new IntersectionObserver(entries => {
      orderInView = entries[0].isIntersecting
    }, { threshold: 0.12 })
    io.observe(box)
    cleanup {
      io.disconnect()
    }
  }

  fn copyOrder() {
    try {
      await navigator.clipboard.writeText(orderText(placed))
      copied = true
    } catch (e) {
      copied = false
    }
  }

  // Muestra qué corregir y lleva el foco a ese campo (field: "" cuando no es un campo).
  fn reject(message, field) {
    error = message
    errorField = field
    if field {
      document.getElementById(`${field}-input`)?.focus()
    }
  }

  fn submit() {
    error = ""
    errorField = ""
    let digits = phone.replace(/\D/g, "").replace(/^00/, "")
    if bags == 0 {
      return reject("Elegí al menos una bolsa de chipa.", "")
    }
    if name.trim().length < 2 {
      return reject("Decinos tu nombre.", "name")
    }
    if name.trim().length > 80 {
      return reject("El nombre es muy largo: usá hasta 80 caracteres.", "name")
    }
    if digits.length < 9 || digits.length > 15 {
      return reject("Revisá el teléfono: necesitamos entre 9 y 15 cifras.", "phone")
    }
    // La dirección sale del buscador (lo libre va en Notas); a mano solo si el buscador no anda.
    if !spot && !geoOffline {
      return reject("Elegí tu dirección de la lista: escribí la calle y el número.", "address")
    }
    if !spot && address.trim().length < 6 {
      return reject("Necesitamos la dirección de entrega.", "address")
    }
    if !spot && address.trim().length > 200 {
      return reject("La dirección es muy larga: usá hasta 200 caracteres.", "address")
    }
    if notes.trim().length > 500 {
      return reject("Las notas son muy largas: usá hasta 500 caracteres.", "notes")
    }
    let order = {
      code: orderCode(),
      name: name.trim(),
      phone: phone.trim(),
      address: spot ? `${spot.full}${spot.postalCode ? ` (${spot.postalCode})` : ""}` : `${address.trim()} (sin verificar)`,
      mapsUrl: spot ? mapsLink(spot) : "",
      notes: notes.trim(),
      items: lines,
      total,
      via: "email",
      failed: false,
    }
    let hold = holdReason(order, openedAt)
    if hold {
      return reject(hold, "")
    }
    if ORDERS_EMAIL {
      sending = true
      let problem = ""
      try {
        problem = await sendByEmail(order)
      } catch (e) {
        problem = e.message
      } finally {
        sending = false
      }
      if problem {
        console.error("Chipa Club: el pedido no se pudo enviar por email:", problem)
        order.via = "dm"
        order.failed = true
      } else {
        rememberOrder(order)
      }
    } else {
      order.via = "dm"
    }
    placed = order
    // La confirmación reemplaza al formulario: el foco va a ella (y el lector de pantalla la lee).
    requestAnimationFrame(() => placedBox?.focus())
    if order.via == "dm" {
      await copyOrder()
    }
    clearCart()
    notes = ""
  }

  // Vuelve a las variedades con los datos del cliente ya escritos (navigate() rearmaría la página).
  fn another() {
    placed = null
    copied = false
    document.getElementById("variedades")?.scrollIntoView()
  }

  column tag=section id="pedido" class="order wrap" ref=box {
    SectionHead kicker="Tu pedido" heading="Hacé tu pedido" light=true {
      text `Completá tus datos y te escribimos para confirmar y coordinar la entrega. ${SHIPPING}.` class="section-sub"
    }
    if placed {
      column class="placed" gap=4 align=center animate=pop ref=placedBox tabindex="-1" {
        text "✓" class="placed-check" aria-hidden="true"
        if placed.via == "email" {
          title `¡Gracias, ${placed.name}!` tag=h3 class="placed-title"
          text `Recibimos tu pedido ${placed.code}. Te vamos a escribir al ${placed.phone} para confirmarlo y coordinar la entrega.` class="placed-text"
        } else {
          title "Último paso: mandanos el pedido por DM" tag=h3 class="placed-title"
          if placed.failed {
            text "No pudimos enviarlo automáticamente, pero no se pierde: mandalo por Instagram y listo." class="placed-text"
          }
          text (copied ? "Ya copiamos tu pedido. Abrí el chat de Instagram, pegalo y envialo." : "Copiá tu pedido, abrí el chat de Instagram, pegalo y envialo.") class="placed-text"
          text orderText(placed) class="placed-ticket" tag=pre
          row gap=3 wrap justify=center {
            link href=INSTAGRAM_DM target="_blank" class="btn btn-mustard" aria-label="Abrir el chat de Instagram (se abre en otra pestaña)" {
              icon "send" size=18
              text "Abrir el chat de Instagram"
            }
            button (copied ? "Copiado ✓" : "Copiar pedido") class="btn btn-ghost-light" -> copyOrder()
          }
        }
        button "Hacer otro pedido" class="btn-link" -> another()
      }
    } else {
      grid class="order-grid" cols=1 lg:cols=2 gap=6 {
        column class="ticket" gap=4 {
          title "Elegí cantidades" tag=h3 class="ticket-title"
          for p in PRODUCTS key p.id {
            row class="ticket-row" gap=3 align=center {
              column class="ticket-thumb" {
                image p.photo alt=""
              }
              column class="ticket-name" {
                text p.name bold
                text `${eur(p.price)} · ${BAG}` class="ticket-meta"
              }
              Stepper id=p.id label=p.name dark=true
            }
          }
          row class="ticket-total" justify=between align=center {
            text (bags > 0 ? plural(bags, "bolsa", "bolsas") : "Todavía no elegiste")
            text eur(total) class="ticket-sum"
          }
        }
        form class="order-form" gap=4 -> submit() {
          input name label="Nombre y apellido" placeholder="Ej. Ana García" id="name-input" aria-invalid=(errorField == "name" ? "true" : null) aria-describedby=(errorField == "name" ? "order-error" : null)
          input phone type=tel label="Teléfono" placeholder="Ej. 600 123 456" id="phone-input" aria-invalid=(errorField == "phone" ? "true" : null) aria-describedby=(errorField == "phone" ? "order-error" : null)
          row class="zone-note" gap=2 align=center role="note" {
            icon "map-pin" size=18
            text `${SHIPPING}.`
          }
          AddressField text=address spot=spot offline=geoOffline invalid=(errorField == "address")
          textarea notes label="Notas (opcional)" placeholder="Piso y puerta, horario que te viene bien, timbre…" rows=2 id="notes-input" aria-invalid=(errorField == "notes" ? "true" : null) aria-describedby=(errorField == "notes" ? "order-error" : null)
          if error {
            text error class="form-error" role="alert" id="order-error"
          }
          button (sending ? "Enviando…" : bags > 0 ? `Enviar pedido · ${eur(total)}` : "Enviar pedido") class="btn btn-mustard btn-block" disabled=sending
          text (ORDERS_EMAIL ? "Sin pago online: lo arreglamos cuando te escribamos." : "Al enviarlo, lo copiamos para que nos lo mandes por DM de Instagram.") class="form-hint"
          text "Usamos tus datos solo para preparar y entregar este pedido. Para encontrar tu dirección usamos CartoCiudad (Instituto Geográfico Nacional) y Photon (OpenStreetMap)." class="form-hint"
        }
      }
    }
  }
}
