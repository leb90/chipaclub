// El pedido: su código, el texto para DM y el envío por email.

// Compartidos con la barra flotante: el último pedido enviado y si el formulario está en pantalla.
state placed: Any = null
state orderInView = false

// Límites contra pedidos repetidos o en masa desde la web. Se cuentan en este navegador: frenan
// los envíos repetidos y el abuso desde la página, no a quien escriba directo a FormSubmit.
const MIN_SECONDS_ON_PAGE = 4
const MAX_ORDERS_PER_HOUR = 3
const REPEAT_MINUTES = 30
const SENT_KEY = "chipaclub-pedidos"

// Los pedidos enviados desde este navegador en las últimas 24 horas: [{ code, at, key }].
fn sentOrders() {
  try {
    let list = JSON.parse(localStorage.getItem(SENT_KEY) ?? "[]")
    return Array.isArray(list) ? list.filter(s => Date.now() - s.at < 24 * 3600 * 1000) : []
  } catch (e) {
    return []
  }
}

// El mismo teléfono con las mismas cantidades es el mismo pedido.
fn orderKey(o) {
  return o.phone.replace(/\D/g, "") + "|" + o.items.map(l => `${l.id}:${l.qty}`).join(",")
}

fn rememberOrder(o) {
  try {
    localStorage.setItem(SENT_KEY, JSON.stringify([...sentOrders(), { code: o.code, at: Date.now(), key: orderKey(o) }]))
  } catch (e) {
    // sin almacenamiento (modo privado): el pedido ya salió, solo no se recuerda
  }
}

// Por qué este pedido no sale ahora, o "" si puede salir.
fn holdReason(o, openedAt) {
  if Date.now() - openedAt < MIN_SECONDS_ON_PAGE * 1000 {
    return "Un segundo: revisá tu pedido y volvé a tocar Enviar."
  }
  let recent = sentOrders()
  let same = recent.find(s => s.key == orderKey(o) && Date.now() - s.at < REPEAT_MINUTES * 60 * 1000)
  if same {
    return `Ya recibimos este mismo pedido hace un rato (${same.code}). Si querés cambiar algo, escribinos por DM.`
  }
  if recent.filter(s => Date.now() - s.at < 3600 * 1000).length >= MAX_ORDERS_PER_HOUR {
    return "Ya enviaste varios pedidos en la última hora. Si necesitás otro, escribinos por DM y lo vemos."
  }
  return ""
}

// Un código corto para seguir el pedido por teléfono o DM: CC-7K2M.
fn orderCode() {
  let abc = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
  let bytes = crypto.getRandomValues(new Uint8Array(4))
  return "CC-" + Array.from(bytes, b => abc[b % abc.length]).join("")
}

// Un móvil español sin prefijo (9 cifras) lleva el 34 delante.
fn whatsappLink(phone) {
  let digits = phone.replace(/\D/g, "").replace(/^00/, "")
  return `https://wa.me/${digits.length == 9 ? "34" + digits : digits}`
}

fn itemsText(items) {
  return items.map(l => `${l.qty} × ${l.name} (${BAG}): ${eur(l.qty * l.price)}`).join("\n")
}

fn orderText(o) {
  return [
    `¡Hola Chipa Club! Quiero hacer un pedido (${o.code}):`,
    "",
    itemsText(o.items),
    `Total: ${eur(o.total)}`,
    "",
    `Nombre: ${o.name}`,
    `Teléfono: ${o.phone}`,
    `Dirección: ${o.address}`,
    o.notes ? `Notas: ${o.notes}` : "",
  ].join("\n").trim()
}

// FormSubmit reenvía el pedido al email (sin servidor propio: el sitio es estático).
// Devuelve "" si llegó, o el motivo por el que no.
fn sendByEmail(o) {
  let res = await fetch(`https://formsubmit.co/ajax/${ORDERS_EMAIL}`, {
    method: "POST",
    headers: { "Content-Type": "application/json", Accept: "application/json" },
    body: JSON.stringify({
      _subject: `Nuevo pedido ${o.code} · ${o.name} · ${eur(o.total)}`,
      _template: "table",
      _captcha: "false",
      "Pedido": o.code,
      "Productos": itemsText(o.items),
      "Total": eur(o.total),
      "Nombre": o.name,
      "Teléfono": o.phone,
      "WhatsApp": whatsappLink(o.phone),
      "Dirección": o.address,
      "Notas": o.notes || "—",
      "Fecha": new Date().toLocaleString("es-ES", { timeZone: "Europe/Madrid", dateStyle: "full", timeStyle: "short" }),
    }),
  })
  let data = await res.json().catch(() => ({}))
  return res.ok && String(data.success) == "true" ? "" : data.message ?? `HTTP ${res.status}`
}
