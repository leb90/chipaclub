// La página: las secciones en orden. Datos y textos en config.art, piezas en ui/ y sections/.
page Home "/" {
  meta title="Chipa Club · Chipa congelada lista para hornear" description=`Chipa congelada, lista para hornear y disfrutar calentita: chorizo colorado, queso azul y nuez, longaniza de Pascua y la clásica. ${SHIPPING}.` image=`${SITE_URL}/photos/chipa-chorizo-colorado.jpg`

  column class="site" {
    Topbar
    Nav
    Hero
    Products
    HowItWorks
    Club
    OrderSection
    Footer
    FloatingCart
  }
}
